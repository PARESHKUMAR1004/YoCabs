  "baseFee": 800,
  "perKmCharge": 16,
  "driverAllowance": 500,
  "minimumBillableKm": 100,
  "includedDurationMinutes": null,
  "includedDistanceKm": null,
  "packagePrice": null,
  "extraHourCharge": null,
  "extraKmCharge": null
}